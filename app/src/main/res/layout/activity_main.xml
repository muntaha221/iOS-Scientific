<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Status bar area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_alignParentStart="true"-->
<!--            android:text="2:21"-->
<!--            android:textColor="#FFFFFF"-->
<!--            android:textSize="18sp"-->
<!--            android:textStyle="bold" />-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_signal"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_wifi"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_battery" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Menu icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_menu"
            app:tint="#FF9F0A" />
    </RelativeLayout>

    <!-- Display area -->
    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="24dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="80sp" />

    <!-- Scientific buttons layout -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="6"
        android:rowCount="5"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <!-- Row 1 -->
        <Button
            android:id="@+id/parenthesisOpen"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="("
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/parenthesisClose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text=")"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/mc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="mc"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/mPlus"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="m+"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/mMinus"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_row="0"
            android:layout_column="4"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="m-"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/mr"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="mr"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/squared"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="2ⁿᵈ"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sqr"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="x²"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cube"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="x³"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/power"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="xʸ"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/exp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="eˣ"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/tenPow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="10ˣ"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/inverse"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="¹/ₓ"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sqrt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="²√x"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cubeRoot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="³√x"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/yRoot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="ʸ√x"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/ln"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="ln"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/log"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="log₁₀"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/factorial"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="x!"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="sin"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cos"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="cos"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/tan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="tan"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/e"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="e"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/EE"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="EE"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <!-- Row 5 -->
        <Button
            android:id="@+id/rand"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="Rand"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sinh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"

            android:text="sinh"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cosh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="cosh"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/tanh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="tanh"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/pi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="π"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/rad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#333333"
            android:text="Rad"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:textSize="18sp" />
    </GridLayout>

    <!-- Standard calculator buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left side buttons (3 columns) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <!-- AC, +/-, % row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/clear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#A5A5A5"
                    android:text="AC"
                    android:textColor="#000000"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/Pm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#A5A5A5"
                    android:text="+/-"
                    android:textColor="#000000"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/per"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#A5A5A5"
                    android:text="%"
                    android:textColor="#000000"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- 7, 8, 9 row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/seven"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="7"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/eight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="8"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/nine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="9"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- 4, 5, 6 row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/four"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/five"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/six"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="6"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- 1, 2, 3 row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/one"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/two"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/three"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Calculator icon, 0, dot row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/calculator"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:drawableStart="@drawable/ic_calculator"
                    android:paddingStart="24dp"
                    android:text="Cal"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/zero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
                <Button
                    android:id="@+id/dot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#333333"
                    android:text="."
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right side operation buttons (1 column) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <Button
                android:id="@+id/div"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/multiply"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/min"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/plus"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/equal"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:backgroundTint="#FF9F0A"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>