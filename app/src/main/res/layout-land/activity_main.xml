<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Menu icon at top -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_menu"
            android:contentDescription="Menu" />
    </RelativeLayout>

    <!-- Display area -->
    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="24dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="72sp" />

    <!-- Button rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:orientation="vertical">

        <!-- First row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/parenthesisOpen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="("
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <Button
                android:id="@+id/parenthesisClose"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text=")"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <Button
                android:id="@+id/mc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="mc"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/mPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="m+"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/mMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="m-"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/mr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="mr"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#A5A5A5"
                android:text="AC"
                android:textColor="#000000"
                android:textSize="11sp" />
            <Button
                android:id="@+id/Pm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#A5A5A5"
                android:text="+/-"
                android:textColor="#000000"
                android:textSize="10sp" />
            <Button
                android:id="@+id/per"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#A5A5A5"
                android:text="%"
                android:textColor="#000000"
                android:textSize="10sp" />
            <Button
                android:id="@+id/div"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9F0A"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Second row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/squared"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="2ⁿᵈ"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/sqr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="x²"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/cube"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="x³"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/power"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="xʸ"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/exp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="eˣ"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/tenPow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="10ˣ"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/seven"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/eight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/nine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/multiply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9F0A"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Third row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/inverse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="¹/ₓ"
                android:textColor="#FFFFFF"
                android:textSize="6sp" />
            <Button
                android:id="@+id/sqrt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="²√x"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/cubeRoot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="³√x"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/yRoot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="ʸ√x"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/ln"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="ln"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/log"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="log₁₀"
                android:textColor="#FFFFFF"
                android:textSize="6sp" />
            <Button
                android:id="@+id/four"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/five"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/six"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/minus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9F0A"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Fourth row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/factorial"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="x!"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/sin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="sin"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
            <Button
                android:id="@+id/cos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="cos"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
            <Button
                android:id="@+id/tan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="tan"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
            <Button
                android:id="@+id/e"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="e"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <Button
                android:id="@+id/EE"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="EE"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <Button
                android:id="@+id/one"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/two"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/three"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/plus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9F0A"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Fifth row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/calculator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="Cal"
                android:drawableStart="@drawable/ic_calculator"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF" />
            <Button
                android:id="@+id/sinh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="sinh"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/cosh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="cosh"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/tanh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="tanh"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/pi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="π"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            <Button
                android:id="@+id/rad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="Rad"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
            <Button
                android:id="@+id/rand"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#333333"
                android:text="Rand"
                android:textColor="#FFFFFF"
                android:textSize="6sp" />
            <Button
                android:id="@+id/zero"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#645F5F"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
            <Button
                android:id="@+id/equal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#FF9F0A"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>